# ---------------------------------------------------------------------------
# GRAM Gateway — environment template (SPEC 117.71-117.84)
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

APP_ENV=local                      # local | test | staging | production
APP_NAME=gram-gateway
APP_URL=http://localhost:3000
APP_PORT=3000
APP_HOST=0.0.0.0
LOG_LEVEL=debug
DEBUG=false                        # MUST be false in production

# Database — `pglite:<dir>` runs embedded; production requires a real server.
DATABASE_URL=pglite:.pgdata
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# CubePay (payment provider)
CUBEPAY_BASE_URL=https://api.cubepay.example
CUBEPAY_API_KEY=
CUBEPAY_WEBHOOK_SECRET=
CUBEPAY_SANDBOX=true               # MUST be false in production

# TON / GRAM
TON_NETWORK=TON_TESTNET            # MUST be TON_MAINNET in production
TON_API_URL=https://testnet.toncenter.com
TON_API_KEY=
TON_REQUIRED_CONFIRMATIONS=1
TON_MOCK=true                      # MUST be false in production
GRAM_ASSET=GRAM
GRAM_NETWORK=TON_TESTNET
GRAM_DECIMALS=9
GRAM_JETTON_MASTER=
GRAM_SAFETY_RESERVE=0

# Treasury — funded MANUALLY by the owner only.
# The application REFUSES TO START if any of these is true.
TREASURY_ADDRESS=
PAYOUT_WALLET_ADDRESS=
TON_SIGNER_REFERENCE=              # KMS/HSM handle; never a raw private key
AUTO_FUNDING=false
AUTO_BUY=false
AUTO_SWAP=false
AUTO_EXCHANGE=false
AUTO_BRIDGE=false

# Commercial policy
PLATFORM_FEE_PERCENT=15
DEFAULT_FEE_MODE=CUSTOMER          # CUSTOMER | MERCHANT | SPLIT
FEE_POLICY_VERSION=v1
PAYOUT_HOLD_HOURS=48
AUTO_PAYOUT_DEFAULT=true
MIN_PAYOUT_TOMAN=10000
MAX_PAYOUT_TOMAN=1000000000
RESERVATION_TTL_SECONDS=900
QUOTE_TTL_SECONDS=300

# Rate source (omit to use STATIC_TOMAN_PER_GRAM)
RATE_SOURCE_URL=
STATIC_TOMAN_PER_GRAM=100000

# Security
HMAC_WINDOW_SECONDS=300
NONCE_TTL_SECONDS=900
SESSION_TTL_SECONDS=3600
API_RATE_LIMIT=120
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=8
WEBHOOK_ALLOWED_SCHEMES=https
TRUST_PROXY=false

# Worker
WORKER_INTERVAL_MS=5000
